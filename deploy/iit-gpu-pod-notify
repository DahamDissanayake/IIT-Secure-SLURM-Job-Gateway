#!/usr/bin/env python3
"""iit-gpu-pod-notify — fires (and clears) any "notify when free" pod
subscriptions whose threshold is currently met.

Run periodically by iit-gpu-pod-notify.timer (every 2 minutes). Must run as
root: iitgpu.pod_notify.check_and_notify() sends mail through the audit
daemon's mail.send verb, which only honours an explicit recipient address
for admin/root callers (SO_PEERCRED-checked) -- a non-admin caller's mail
gets forced to their own address (anti-relay), which would break this
checker's whole purpose of emailing someone ELSE once their threshold hits.
"""
import os
import sys

sys.path.insert(0, "/opt/iit-gpu")
os.environ.setdefault("NFS_ROOT", "/shared")
os.environ.setdefault("IIT_SITE_ENV", "/opt/iit-gpu/deploy/site.env")

from iitgpu.pod_notify import check_and_notify  # noqa: E402

if __name__ == "__main__":
    n = check_and_notify()
    if n:
        print(f"iit-gpu-pod-notify: sent {n} notification(s)")
