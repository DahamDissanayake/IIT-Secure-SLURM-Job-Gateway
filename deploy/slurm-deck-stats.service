[Unit]
Description=Slurm Deck stats writer — feeds live metrics to NFS for dashboard
Documentation=https://github.com/DahamDissanayake/slurm-deck
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/slurm-deck-stats-writer
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal
# Run as root-daham so it can write to /shared (NFS-mounted, world-writable)
User=root-daham

[Install]
WantedBy=multi-user.target
