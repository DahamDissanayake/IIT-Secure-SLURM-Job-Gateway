# Slurm Deck: allow gpuusers to run SLURM commands as the shared identity
# (GATEWAY_SHARED_USER_NAME in site.env, default "shared"). That account must
# exist with matching UIDs on both the login node and the GPU node, so
# slurmstepd can resolve it and set up the job environment. Edit the username
# below if you changed GATEWAY_SHARED_USER_NAME -- this file is copied
# verbatim by install.sh, not templated.
Defaults:gpuusers !lecture, timestamp_timeout=0

%gpuusers ALL=(shared) NOPASSWD: /usr/bin/sbatch, /usr/bin/squeue, /usr/bin/scancel, /usr/bin/sinfo, /usr/bin/sacct
