# DEPLOYMENT PREREQUISITE (manual, one time): redeploy-igm.sh syncs
# /usr/local/bin/iit-gpu-pod-notify but does NOT install this unit file or
# the .timer -- do that once with:
#   sudo install -m 0644 deploy/iit-gpu-pod-notify.service /etc/systemd/system/
#   sudo install -m 0644 deploy/iit-gpu-pod-notify.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now iit-gpu-pod-notify.timer
[Unit]
Description=IIT GPU pod-notify checker (one-shot, fired by the .timer)
Documentation=https://github.com/DahamDissanayake/IIT-Secure-SLURM-Job-Gateway
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/bin/iit-gpu-pod-notify
# Must be an admin identity (gpuadmins member), NOT literal root: the audit
# daemon only honours an explicit mail recipient for admin/root callers, but
# /shared has root_squash (NFS export), so an actual root process gets
# mapped to the anonymous uid and can't read/write the subscriptions file.
# Confirmed live: User=root failed with PermissionError on
# /shared/.pod-notify-subscriptions.json.
#
# NOT slurmadmin or gpusync either, even though both carry the gpuadmins
# GID on the login node: neither exists as a LOCAL account on the GPU host
# (the NFS server), so the gpuadmins ACL grant on /shared doesn't resolve
# for them over NFS -- confirmed live, both got PermissionError creating a
# file at /shared top level despite `id` showing gpuadmins in their groups.
# dahamadmin is provisioned identically (same uid/gid, gpuadmins member) on
# BOTH nodes and was confirmed live to write successfully.
User=dahamadmin
StandardOutput=journal
StandardError=journal
